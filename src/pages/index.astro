---
import AsciiLayout from '../layouts/AsciiLayout.astro';
---

<AsciiLayout title="Svein // Inicio - Portafolio TUI">
  <!-- Hero / Identity Box -->
  <section class="ascii-box">
    <div class="ascii-box-header">
      <span class="ascii-box-title">
        <span class="text-green">#</span>
        <span>IDENTIFICACIÓN DEL SISTEMA</span>
      </span>
      <span>SYS_ID: 0x05 // DISPONIBLE</span>
    </div>
    <div class="ascii-box-body">
      <!-- Clean ASCII Logo -->
      <div class="ascii-art-wrapper" aria-hidden="true">
   ____            _         ___  ____  
  / ___|_   _____ (_)_ __   / _ \| ___| 
  \___ \ \ / / _ \| | '_ \ | | | |___ \ 
   ___) \ V /  __/| | | | || |_| |___) |
  |____/ \_/ \___||_|_| |_(_)___/|____/ 
      </div>

      <h1 style="font-size: 1.4rem; margin-bottom: 0.5rem;">
        Svein <span class="text-dim">// Software Developer</span>
      </h1>

      <p class="text-muted" style="max-width: 720px; margin-bottom: 1.25rem;">
        Desarrollador de software enfocado en la construcción de sistemas eficientes, interfaces sobrias y código limpio. Especializado en arquitecturas web modernas, APIs robustas y rendimiento de alto nivel.
      </p>

      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/proyectos" class="ascii-btn">
          <span>&gt; EXPLORAR PROYECTOS</span>
        </a>
        <a href="/sobre-mi" class="ascii-btn secondary">
          <span>&gt; LEER CV / PERFIL</span>
        </a>
        <a href="/contacto" class="ascii-btn secondary">
          <span>&gt; CONTACTAR</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Directory / Menu Box -->
  <section class="ascii-box">
    <div class="ascii-box-header">
      <span class="ascii-box-title">
        <span class="text-cyan">&gt;</span>
        <span>DIRECTORIO DE SECCIONES</span>
      </span>
      <span>4 RUTAS DISPONIBLES</span>
    </div>
    <div class="ascii-box-body" style="padding: 0;">
      <div class="ascii-table-responsive" style="margin: 0;">
        <table class="ascii-table">
          <thead>
            <tr>
              <th style="width: 25%;">Ruta</th>
              <th style="width: 50%;">Descripción</th>
              <th style="width: 25%;">Acción</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="text-cyan">/proyectos</span></td>
              <td class="text-muted">Catálogo completo de proyectos con especificaciones técnicas y enlaces de código.</td>
              <td><a href="/proyectos">[ ACCEDER ➔ ]</a></td>
            </tr>
            <tr>
              <td><span class="text-cyan">/sobre-mi</span></td>
              <td class="text-muted">Currículum técnico, filosofía de ingeniería y matriz de habilidades clasificadas.</td>
              <td><a href="/sobre-mi">[ ACCEDER ➔ ]</a></td>
            </tr>
            <tr>
              <td><span class="text-cyan">/contacto</span></td>
              <td class="text-muted">Vías de comunicación directa, perfil de GitHub y disponibilidad profesional.</td>
              <td><a href="/contacto">[ ACCEDER ➔ ]</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Telemetry / Environment Specs Box -->
  <section class="ascii-box">
    <div class="ascii-box-header">
      <span class="ascii-box-title">
        <span class="text-amber">i</span>
        <span>ESPECIFICACIONES DEL ENTORNO</span>
      </span>
      <span>INFO TÉCNICA</span>
    </div>
    <div class="ascii-box-body">
      <div class="ascii-table-responsive" style="margin: 0;">
        <table class="ascii-table">
          <tbody>
            <tr>
              <td style="width: 30%;" class="text-muted">FRAMEWORK</td>
              <td>Astro 5 (Static Site Generation / SSG)</td>
            </tr>
            <tr>
              <td class="text-muted">ESTILO & UI</td>
              <td>TUI / Pure ASCII (Zero-bloat, sin fuentes externas pesadas ni neón)</td>
            </tr>
            <tr>
              <td class="text-muted">INFRAESTRUCTURA</td>
              <td>Cloudflare Pages Global Edge Network</td>
            </tr>
            <tr>
              <td class="text-muted">CONTROL DE VERSIONES</td>
              <td>Git Flow Estricto</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</AsciiLayout>
